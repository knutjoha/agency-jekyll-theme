# Server only. Leave both unset to keep the fixture lists.
# Copy real values into family-hub/.env.local, which is gitignored.
# Never prefix these with NEXT_PUBLIC_. The browser must not receive the key.
# SUPABASE_URL is the project URL only, with no key in the string.
# SUPABASE_SECRET_KEY is the secret key (sb_secret_...) or, on an older project, the legacy service_role key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
