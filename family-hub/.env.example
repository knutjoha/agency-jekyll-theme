# Server only. Copy real values into family-hub/.env.local, which is gitignored.
# Never prefix these with NEXT_PUBLIC_. The browser must not receive the key.
# SUPABASE_URL is the project URL only, with no key in the string.
# SUPABASE_SECRET_KEY is the secret key (sb_secret_...) or, on an older project, the legacy service_role key.
# Leave the Supabase pair unset to keep the fixture lists.
# Leave the Google four unset to keep the fixture calendar.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
# Dinner planner. Server only. No NEXT_PUBLIC_ prefix and no values in git.
# DINNER_PLANNER=xai selects the xAI API. Unset uses Anthropic. DINNER_MODEL overrides the pinned model id.
ANTHROPIC_API_KEY=
XAI_API_KEY=
DINNER_PLANNER=
DINNER_MODEL=
CRON_SECRET=
